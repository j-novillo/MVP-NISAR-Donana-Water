# Copiar a .env y rellenar. .env está en .gitignore y no debe subirse.
# El código solo lee variables de entorno (y, si existe, un .env local).

# Token de portador de NASA Earthdata (https://urs.earthdata.nasa.gov/).
# Hace falta para DESCARGAR de ASF. La búsqueda del catálogo puede ir sin token.
EARTHDATA_TOKEN=

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu/).
# Preferir usuario y contraseña: el cliente renueva el access token solo
# (caduca en unos 10-30 minutos). No hace falta pegar el token a mano.
CDSE_USERNAME=
CDSE_PASSWORD=

# Alternativa si no se quieren dejar usuario y contraseña en el entorno.
# Caduca pronto; cuando falle con 401 hay que generar otro.
# CDSE_ACCESS_TOKEN=
